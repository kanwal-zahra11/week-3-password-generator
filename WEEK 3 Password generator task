import secrets
import string
import math
 
min_length = 15
max_length = 64
 
 
def get_length():
    while True:
        user_input = input("Enter password length (15-64): ")
        if user_input.isdigit() == False:
            print("Please enter a number only")
            continue
 
        length = int(user_input)
 
        if length < min_length:
            print("Length is less than recommended 15 characters")
            choice = input("Do you still want to continue? (y/n): ")
            if choice != "y":
                continue
            else:
                return length
 
        if length > max_length:
            print("Length too big, setting it to 64")
            length = max_length
            return length
 
        return length
 
 
def get_character_pool():
    letters = string.ascii_letters
    numbers = string.digits
    symbols = string.punctuation
    pool = letters + numbers + symbols
    return pool
 
 
def generate_password(length, pool):
    password = ""
    count = 0
    while count < length:
        random_char = secrets.choice(pool)
        password = password + random_char
        count = count + 1
    return password
 
 
def has_letter(password):
    for char in password:
        if char in string.ascii_letters:
            return True
    return False
 
 
def has_number(password):
    for char in password:
        if char in string.digits:
            return True
    return False
 
 
def has_symbol(password):
    for char in password:
        if char in string.punctuation:
            return True
    return False
 
 
def calculate_entropy(length, pool_size):
    entropy = length * math.log2(pool_size)
    return entropy
 
 
def get_strength(entropy):
    if entropy < 50:
        strength = "Weak"
    elif entropy < 80:
        strength = "Reasonable"
    elif entropy < 100:
        strength = "Strong"
    else:
        strength = "Very Strong"
    return strength
 
 
def main():
    print("Welcome to Password Generator")
    print("------------------------------")
 
    length = get_length()
    pool = get_character_pool()
 
    password = generate_password(length, pool)
 
    while has_letter(password) == False or has_number(password) == False or has_symbol(password) == False:
        password = generate_password(length, pool)
 
    pool_size = len(pool)
    entropy = calculate_entropy(length, pool_size)
    strength = get_strength(entropy)
 
    print("")
    print("Your generated password is:", password)
    print("Password length:", length)
    print("Entropy value:", round(entropy, 1), "bits")
    print("Password strength:", strength)
 
 
main()
 